[Unit]
Description=nas-os base firewall
Documentation=https://github.com/ValerioGc/nas-wizard
DefaultDependencies=no
After=nftables.service
Before=network-pre.target shutdown.target
Wants=nftables.service network-pre.target
PartOf=nftables.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/nas-os-configuration/base-firewall.sh
ExecStop=/usr/local/lib/nas-os-configuration/base-firewall.sh --remove

[Install]
WantedBy=sysinit.target
