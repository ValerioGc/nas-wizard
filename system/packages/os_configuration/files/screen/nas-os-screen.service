# The screen of the NAS. Watches the video outputs, the keyboards and the mice, and starts the
# browser on a monitor connected to the NAS (nas-os-screen-browser.service) only while one is and
# tty1 is the console in front, until the minutes untouched of the power settings put it in standby.
# Installed by scripts/screen.sh.

[Unit]
Description=nas-os screen, the interface on a monitor connected to the NAS
Documentation=https://github.com/ValerioGc/nas-wizard
ConditionPathExists=/usr/local/lib/nas-wizard/wizard/bin/nas-wizard
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/lib/nas-wizard/wizard/bin/nas-wizard screen
# Stopped in standby, it would leave the screen dark: light it again for the text login.
ExecStopPost=-+/bin/sh -c 'for blank in /sys/class/graphics/fb*/blank; do echo 0 >"$$blank"; done'
Restart=on-failure
RestartSec=5

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input r
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
Environment=TOKIO_WORKER_THREADS=1 MALLOC_ARENA_MAX=1

[Install]
WantedBy=multi-user.target
