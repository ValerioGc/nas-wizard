# The port of the wizard, on the loopback: Vite forwards /api to it.
WIZARD_PORT=${WIZARD_PORT:-3006}
WIZARD_ADDRESS=${WIZARD_ADDRESS:-127.0.0.1}
# Anything other than `real` simulates the installation.
WIZARD_MODE=${WIZARD_MODE:-simulated}
# A file with the token of the private releases, as the entry script would hand it over.
WIZARD_TOKEN_PATH=${WIZARD_TOKEN_PATH:-}
